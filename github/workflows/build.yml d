
name: Build Aquarium APK

'on':
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.13'

      - name: Extract project
        run: |
          unzip AkvaryumCanliDuvarKagidi-DUZELTILMIS.zip -d extracted

      - name: Build APK
        run: |
          gradle -p extracted/AkvaryumCanliDuvarKagidi assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Akvaryum-APK
          path: extracted/AkvaryumCanliDuvarKagidi/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
